{
  "id": "land_garden_land",
  "label": "Land (garden land)",
  "description": "Generic garden land sequestration/removals. Use if you want to treat gardens differently from grassland/woodland (e.g. managed land). Provide your own rate.",
  "type": "place",
  "subtype": "garden_land",
  "current_role": "passive",
  "inputs": [
    {
      "key": "area_ha",
      "label": "Area",
      "kind": "number",
      "unit": "ha",
      "help": "Area in hectares. (1 ha = 10,000 m²)"
    },
    {
      "key": "net_removals_tco2e_per_ha_per_year",
      "label": "Net removals rate",
      "kind": "number",
      "unit": "tCO2e/ha/year",
      "help": "Net annual removals (positive) or emissions (negative) per hectare per year. Use your chosen factor/source."
    }
  ],
  "outputs": [
    {
      "key": "net_removals_tco2e_per_year",
      "label": "Net removals",
      "kind": "number",
      "unit": "tCO2e/year",
      "formula": "area_ha * net_removals_tco2e_per_ha_per_year"
    },
    {
      "key": "emissions_tco2e_per_year",
      "label": "Net emissions (negative means removals)",
      "kind": "number",
      "unit": "tCO2e/year",
      "formula": "-(area_ha * net_removals_tco2e_per_ha_per_year)"
    }
  ]
}
