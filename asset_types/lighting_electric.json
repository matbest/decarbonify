{
  "id": "lighting_electric",
  "label": "Lighting (electric)",
  "description": "Electric lighting load. Computes annual tCO2e from installed power and average daily usage.",
  "core_type": "asset",
  "subtype": "lighting",
  "current_role": "consumer",
  "attributes": {
    "energy_type": "electricity"
  },
  "inputs": [
    {
      "key": "total_power_watts",
      "label": "Total installed power",
      "kind": "number",
      "unit": "W",
      "help": "Sum of lamp/luminaire power for the area covered."
    },
    {
      "key": "average_daily_usage_hours",
      "label": "Average daily usage",
      "kind": "number",
      "unit": "hours/day",
      "help": "Average hours of use per day."
    },
    {
      "key": "carbon_intensity_of_electricity",
      "label": "Electricity carbon intensity",
      "kind": "number",
      "unit": "kgCO2e/kWh",
      "default": 0.20,
      "help": "Grid carbon intensity used to convert kWh into emissions."
    }
  ],
  "outputs": [
    {
      "key": "annual_electricity_kwh",
      "label": "Estimated annual electricity use",
      "kind": "number",
      "unit": "kWh/year",
      "formula": "(total_power_watts / 1000) * average_daily_usage_hours * 365"
    },
    {
      "key": "emissions_tco2e_per_year",
      "label": "Emissions",
      "kind": "number",
      "unit": "tCO2e/year",
      "formula": "((total_power_watts / 1000) * average_daily_usage_hours * 365 * carbon_intensity_of_electricity) / 1000"
    }
  ]
}
